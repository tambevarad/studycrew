# Copy to .env.local (Next.js) AND .env (Prisma CLI reads .env): cp .env.example .env && cp .env.example .env.local

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://studycrew:studycrew@localhost:5432/studycrew"
# Separate database for integration tests (created by docker-compose init script)
TEST_DATABASE_URL="postgresql://studycrew:studycrew@localhost:5432/studycrew_test"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-random-bytes-base64"
BETTER_AUTH_URL="http://localhost:3000"

# AI Coverage Check (PB-10): openai | gemini | claude | mock. Tests always use mock.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
