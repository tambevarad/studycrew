{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/sign-in",
        "http://localhost:3000/dashboard",
        "http://localhost:3000/teams",
        "http://localhost:3000/profile",
        "http://localhost:3000/availability",
        "http://localhost:3000/notifications"
      ],
      "numberOfRuns": 3,
      "puppeteerScript": "./perf/lhci-login.cjs",
      "puppeteerLaunchOptions": { "args": ["--no-sandbox"] },
      "settings": { "preset": "desktop", "disableStorageReset": true }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./perf/results/lighthouse" }
  }
}
